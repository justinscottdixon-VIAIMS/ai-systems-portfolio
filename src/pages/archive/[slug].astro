---
import { musicReleaseGroups } from '../../lib/music-release-timeline.mjs';
import ArchiveLayout from '../../layouts/ArchiveLayout.astro';
import TrackCredits from '../../components/TrackCredits.astro';
import DossierContext from '../../components/DossierContext.astro';
import ReleaseHistory from '../../components/ReleaseHistory.astro';
import ReleasePresentations from '../../components/ReleasePresentations.astro';
import ReleaseListening from '../../components/ReleaseListening.astro';
import ReleaseAudio from '../../components/ReleaseAudio.astro';
import PressClippings from '../../components/PressClippings.astro';
import DossierMedia from '../../components/DossierMedia.astro';
import source from '../../data/portfolio-records.json';
import { toPortfolioRecords } from '../../lib/portfolio-records.mjs';
import { toCredentialCollections } from '../../lib/credential-collections.mjs';
import { selectReleaseRecords } from '../../lib/release-scope.mjs';
import { archiveHref } from '../../lib/archive-index.mjs';
export function getStaticPaths() {
  const canonicalRecords = selectReleaseRecords(toPortfolioRecords(source), process.env.VIAIMS_RELEASE_SCOPE);
  const grouped = !process.env.VIAIMS_RELEASE_SCOPE || process.env.VIAIMS_RELEASE_SCOPE === 'full' ? new Map(toCredentialCollections(canonicalRecords).map(record => [record.id, record])) : new Map();
  return canonicalRecords.map(record => ({ params: { slug: record.slug }, props: { record: grouped.get(record.id) ?? record } }));
}
const { record } = Astro.props;
const timelineGroups = record.id === 'singles-remixes' ? musicReleaseGroups(record.children) : [];
const timelineStarts = new Map(timelineGroups.map(group => [group.children[0].id, group.title]));
const recordsById = new Map(selectReleaseRecords(toPortfolioRecords(source), process.env.VIAIMS_RELEASE_SCOPE).map(item => [item.id, item]));
const evidenceLabels = {
  'primary-public': 'Primary public source', 'corroborated-public': 'Corroborated public record',
  'attributed-public': 'Attributed public record', 'owner-approved-archive': 'Artist-approved archive',
};
---
<ArchiveLayout title={record.title} description={record.summary}>
  <header class="archive-heading">
    <p class="eyebrow">{record.era}</p><h1>{record.title}</h1>
    <p class="artist">{record.displayArtistOrClient}</p><p class="lead">{record.summary}</p>
    <dl class="archive-facts">
      <div><dt>Period</dt><dd>{record.dateDisplay}</dd></div>
      <div><dt>Contribution</dt><dd>{record.roles.join(' · ')}</dd></div>
      <div><dt>Source status</dt><dd>{evidenceLabels[record.evidenceLevel]}</dd></div>
      <div><dt>Record status</dt><dd>{record.status.replaceAll('-', ' ')}</dd></div>
    </dl>
  </header>
  <ReleaseListening links={record.listeningLinks} />
  {record.gallery.filter(item => item.kind === 'image').map(item => <figure class="archive-art"><img src={item.src} alt={item.alt} loading="lazy" decoding="async" /><figcaption>{item.caption}</figcaption></figure>)}
  <nav class="archive-contents" aria-label="Dossier contents"><h2>In this dossier</h2><ul>
    {record.sections.map((section, index) => <li><a href={`#history-${index + 1}`}>{section.title}</a></li>)}
    {timelineGroups.length ? timelineGroups.map(group => <li><strong>{group.title}</strong><ul>{group.children.map(child => <li><a href={`#${child.id}`}>{child.title}</a></li>)}</ul></li>) : record.children.map(child => <li><a href={`#${child.id}`}>{child.catalogNumber} · {child.title}</a></li>)}
    {(record.contextRecords ?? []).map(context => <li><a href={`#context-${context.id}`}>{context.title}</a></li>)}
    <li><a href="#sources">Sources & attribution</a></li>
    {record.id === 'cosmic-records-history' && <li><a href="#press-clippings">Articles & interviews</a></li>}
    {record.id === 'cosmic-records-history' && <><li><a href="#further-resources">Further reading & listening</a></li><li><a href="#watch-listen">Watch & listen on YouTube</a></li></>}
  </ul></nav>
  {record.sections.map((section, index) => section.placement !== 'after-releases' && <section class="archive-section" id={`history-${index + 1}`}>
    <p class="eyebrow">HISTORY & CONTEXT</p><h2>{section.title}</h2>{section.intro && <p>{section.intro}</p>}
    {section.items.map(item => <div class="history-item"><h3>{item.title}</h3>{item.date && <p class="muted">{item.date}</p>}<p>{item.detail}</p>{item.href && <a href={item.href} target="_blank" rel="noopener noreferrer">Read the source ↗</a>}</div>)}
  </section>)}
  {record.children.map(child => <>{timelineStarts.has(child.id) && <h2 class="archive-timeline-year">{timelineStarts.get(child.id)}</h2>}<article class:list={["archive-section release-record", { "release-record--package": child.id === "transformed" }]} id={child.id}>
    {child.id === 'cosmic-018' && <header class="archive-packaging-heading"><p class="eyebrow">{child.catalogNumber} · CD packaging</p><h2>{child.title}</h2><p>Front and back panels, joined inside booklet, tray inlay and disc. Open an image to inspect it at full size.</p></header>}
    <div class:list={{ 'archive-packaging': child.id === 'cosmic-018' }}>
      {(child.id === 'transformed' ? child.gallery.slice(0, 1) : child.gallery).map((item, index) => <figure class:list={['archive-art', { 'archive-art--spread': child.id === 'cosmic-018' && item.src?.includes('-spread-') }]} id={child.id === 'cosmic-018' ? `cosmic-018-artwork-${index + 1}` : undefined}>{item.kind === 'image' ? child.id === 'cosmic-018' ? <a href={item.src} target="_blank" rel="noopener noreferrer" aria-label={`Open full-size artwork: ${item.alt}`}><img src={item.src} alt={item.alt} loading="lazy" decoding="async" /></a> : <img src={item.src} alt={item.alt} loading="lazy" decoding="async" /> : <div class="art-pending">Presentation artwork forthcoming</div>}<figcaption>{item.caption}</figcaption></figure>)}
    </div>
    <div><p class="eyebrow">{child.catalogNumber}</p>{child.id !== 'cosmic-018' && <h2>{child.title}</h2>}<p class="artist">{child.artist}</p>
      <dl class="archive-facts"><div><dt>Date evidence</dt><dd>{child.date}</dd></div><div><dt>Format</dt><dd>{child.format}</dd></div>{child.roles.length > 0 && <div><dt>Contribution</dt><dd>{child.roles.join(' · ')}</dd></div>}</dl>
      <p>{child.summary}</p>
      <ReleasePresentations links={child.presentationLinks} />
      <ReleaseAudio clips={child.audioClips} />
      <ReleaseListening links={child.listeningLinks} />
      {child.credits.length > 0 && <TrackCredits credits={child.credits} />}
      <ReleaseHistory sections={child.historySections} headingLevel={3} />
      {(child.contextRecords ?? []).map(context => <DossierContext record={context} release={child} sourcesAlreadyShown />)}
      {child.publicSources.length > 0 && <div class="edition-sources"><h3>Edition sources</h3><ul>{child.publicSources.map(source => <li><a href={source.href} target="_blank" rel="noopener noreferrer">{source.label} ↗</a><p class="muted">{source.supports}</p></li>)}</ul></div>}
      {child.relatedRecordIds.length > 0 && <nav aria-label={`${child.title} related histories`}><h3>Related release histories</h3><ul>{child.relatedRecordIds.map(id => <li><a href={archiveHref(recordsById.get(id))}>{recordsById.get(id).title}</a></li>)}</ul></nav>}
      <a class="permalink" href={archiveHref(record, child)}>Link to this release ↗</a>
    </div>
    {child.id === 'transformed' && <section class="archive-package-panels" aria-label="Transformed CD packaging"><h3>Inside the CD package</h3><p>Original packaging scans. Open any panel at full size.</p><div class="archive-package-panels__grid">{child.gallery.slice(1).map((item, index) => item.kind === 'image' && <figure class="archive-art" id={`transformed-artwork-${index + 2}`}><a href={item.src} target="_blank" rel="noopener noreferrer" aria-label={`Open full-size artwork: ${item.alt}`}><img src={item.src} alt={item.alt} loading="lazy" decoding="async" /></a><figcaption>{item.caption}</figcaption></figure>)}</div></section>}
  </article></>)}
  {record.sections.map((section, index) => section.placement === 'after-releases' && <section class="archive-section" id={`history-${index + 1}`}>
    <p class="eyebrow">HISTORY & CONTEXT</p><h2>{section.title}</h2>{section.intro && <p>{section.intro}</p>}
    {section.items.map(item => <div class="history-item"><h3>{item.title}</h3>{item.date && <p class="muted">{item.date}</p>}<p>{item.detail}</p>{item.href && <a href={item.href} target="_blank" rel="noopener noreferrer">Read the source ↗</a>}</div>)}
  </section>)}
  {(record.contextRecords ?? []).map(context => <section class="archive-section" id={`context-${context.id}`}><p class="eyebrow">COLLECTION CONTEXT</p><h2>{context.title}</h2>{context.gallery.filter(item => item.kind === 'image').map(item => <figure class="archive-art"><img src={item.src} alt={item.alt} loading="lazy" decoding="async" /><figcaption>{item.caption}</figcaption></figure>)}<DossierContext record={context} /></section>)}
  {record.relatedRecordIds.length > 0 && <section class="archive-section"><h2>Related release histories</h2><ul>{record.relatedRecordIds.map(id => <li><a href={archiveHref(recordsById.get(id))}>{recordsById.get(id).title}</a></li>)}</ul></section>}
  <section id="sources" class="archive-section"><p class="eyebrow">PUBLIC REFERENCES</p><h2>Sources & attribution</h2>
    <p>Creative-history passages include Dixon’s recollections. Linked sources support the specific subjects described below.</p>
    <ul class="source-list">{record.publicSources.map(item => <li><a href={item.href} target="_blank" rel="noopener noreferrer">{item.label} ↗</a><p>{item.supports}</p></li>)}</ul>
  </section>
  {record.id === 'cosmic-records-history' && <PressClippings />}
  {record.id === 'cosmic-records-history' && <DossierMedia />}
</ArchiveLayout>

<script>
  // Preserve saved edition links after consolidating these releases into Cosmic.
  const movedEditions = {
    'nc-01': 'sunshine-state-of-mind',
    'nc-08': 'sunshine-state-of-mind',
    'nc-14': 'groove-me-suenos',
    'nc-17': 'mad-free',
  };
  const followMovedEdition = () => {
    const hash = window.location.hash.slice(1);
    if (window.location.pathname === '/archive/singles-remixes/' && hash === 'nc-09') {
      window.location.replace('/archive/singles-remixes/#compilation-appearances-d003');
      return;
    }
    const oldId = window.location.pathname === '/archive/singles-remixes/' ? hash
      : window.location.pathname === '/archive/cosmic-records-history/' ? hash.replace(/^singles-remixes-/, '') : '';
    const destination = movedEditions[oldId];
    if (destination) window.location.replace(`/archive/cosmic-records-history/#${destination}`);
  };
  followMovedEdition();
  window.addEventListener('hashchange', followMovedEdition);
</script>
