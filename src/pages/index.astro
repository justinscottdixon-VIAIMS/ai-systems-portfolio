---
import Layout from '../layouts/Layout.astro';
import HybridMediaEngine from '../components/HybridMediaEngine.astro';
import { loadBuildMediaData } from '../lib/build-media-manifest.mjs';
import { getMediaOrigin, parseMediaManifest } from '../lib/media-manifest.mjs';

const mediaData = await loadBuildMediaData({ manifestPath: process.env.VIAIMS_MEDIA_MANIFEST_PATH });
const mediaManifest = parseMediaManifest(mediaData);
const mediaOrigin = getMediaOrigin(mediaManifest);
---

<Layout compactMain>
	{mediaOrigin && (
		<Fragment slot="head">
			<link rel="preconnect" href={mediaOrigin} crossorigin="anonymous" />
			<link rel="dns-prefetch" href={mediaOrigin} />
		</Fragment>
	)}
	<header class="institutional-header" data-institutional-header>
		<div class="institutional-status">
			<div class="institutional-status__clock">
				<span class="inline-block w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
				<span>SYSTEM ARCHITECTURE ONLINE</span>
				<span class="text-zinc-800">|</span>
				<span>CLOCK: AES67 MASTER LOCKED</span>
			</div>
			<span class="institutional-status__reference">REF: JSD-2026.PROD</span>
		</div>

		<div data-institutional-identity class="institutional-nameplate text-center uppercase">
			<h1>
				JUSTIN SCOTT DIXON
			</h1>
			<div class="institutional-nameplate__organization">
				<p>VOYAGER INSTITUTE OF AI MUSIC SYSTEMS</p>
				<p>(VIAIMS)</p>
			</div>
		</div>
		<p class="institutional-roles">
			<span>AI SYSTEMS ARCHITECT · CREATIVE TECHNOLOGIST</span>
			<span>MUSIC / VIDEO PRODUCER</span>
			<span>SPATIAL AUDIO ENGINEER · SONGWRITER</span>
			<span>SOUND DESIGNER · VISUAL STORYTELLER</span>
		</p>
	</header>

	<section>
		<HybridMediaEngine manifest={mediaManifest} />
	</section>

</Layout>
