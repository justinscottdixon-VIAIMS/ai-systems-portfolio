---
import { publicProfile, publicContact } from '../lib/public-site.mjs';
const contact = publicContact(process.env.VIAIMS_PUBLIC_CONTACT ?? publicProfile.contact);
---
<section class="public-introduction" aria-labelledby="public-introduction-title">
 <div>
  <p class="public-introduction__label">SOUND · VISION · SYSTEMS</p>
  <h2 id="public-introduction-title">Music, moving image and creative technology.</h2>
  {publicProfile.introduction.split('\n\n').map((paragraph) => <p>{paragraph}</p>)}
  <a href={publicProfile.channel} target="_blank" rel="noopener noreferrer">Explore the YouTube channel ↗</a>
 </div>
 {contact && <div class="public-introduction__contact" id="contact">
  <h2>Discuss a project</h2>
  <p>For music production, spatial audio and visual collaborations, share a brief outline of your project, the intended deliverables and your timeframe.</p>
  <a class="public-introduction__cta" href={contact}>Discuss a project ↗</a>
 </div>}
 <div class="public-brand" role="img" aria-label="VIAIMS — Sound / Vision / Systems">
  <img class="public-brand__logo" src="/brand/viaims-logo-original.jpg" alt="" loading="lazy" decoding="async" />
 </div>
</section>
<style>
.public-introduction { position:relative; isolation:isolate; overflow:hidden; }
.public-introduction > div { position:relative; z-index:1; }
.public-brand { grid-column:1 / -1; justify-self:center; width:min(100%,22rem); aspect-ratio:768 / 580; overflow:hidden; mix-blend-mode:screen; }
.public-brand__logo { display:block; width:100%; height:100%; object-fit:cover; object-position:center 48.267%; }
.public-introduction { display:grid; grid-template-columns:repeat(auto-fit,minmax(min(100%,22rem),1fr)); gap:2rem; margin-top:2rem; padding:clamp(1rem,3vw,2rem); border:1px solid #b59b6666; background:var(--viaims-panel); color:var(--viaims-muted); border-color:var(--viaims-brass); border-radius:.7rem; }
.public-introduction__label { color:#c9b182; font-size:.7rem; letter-spacing:.12em; }
.public-introduction h2 { color:var(--viaims-ink); font-size:clamp(1.3rem,3vw,1.8rem); line-height:1.25; margin:.5rem 0 1rem; }
.public-introduction p:not(.public-introduction__label) { max-width:65ch; line-height:1.75; margin-bottom:1rem; }
.public-introduction a { color:#e7d3a6; text-decoration:underline; text-underline-offset:.25em; display:inline-block; padding-block:.7rem; }
.public-introduction a:focus-visible { outline:2px solid #e7d3a6; outline-offset:4px; }
.public-introduction__cta { border:1px solid #b59b66; padding:.75rem 1rem; min-height:44px; }
</style>
