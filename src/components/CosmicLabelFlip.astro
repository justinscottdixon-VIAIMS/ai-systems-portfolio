---
interface LabelImage {
	src: string;
	alt: string;
	caption?: string;
}

interface Props {
	front: LabelImage;
	back: LabelImage;
	title: string;
}

const { front, back, title } = Astro.props;
---

<cosmic-label-flip class="cosmic-label-flip" data-cosmic-label-flip data-title={title} data-side="front">
	<button
		class="cosmic-label-flip__button"
		type="button"
		data-flip-button
		aria-label={`Flip label for ${title}. Show other side.`}
		disabled
	>
		<span class="cosmic-label-flip__viewport">
			<span class="cosmic-label-flip__rotor">
				<img class="cosmic-label-flip__face cosmic-label-flip__face--front" data-flip-front src={front.src} alt={front.alt} aria-hidden="false" loading="lazy" decoding="async" draggable="false" />
				<img class="cosmic-label-flip__face cosmic-label-flip__face--back" data-flip-back src={back.src} alt={back.alt} aria-hidden="true" loading="lazy" decoding="async" draggable="false" />
			</span>
		</span>
		<span class="cosmic-label-flip__hint" aria-hidden="true">
			<strong data-flip-action>Information side</strong>
			<span data-flip-hint hidden>Show other side ↻</span>
		</span>
	</button>
	<p class="cosmic-label-flip__status" data-flip-status role="status" aria-live="polite" aria-atomic="true">Information side shown: {front.alt}</p>
	<p class="cosmic-label-flip__fallback" data-flip-fallback>
		<a href={back.src}>View the other side of {title}</a>
	</p>
</cosmic-label-flip>

<script>
	class CosmicLabelFlip extends HTMLElement {
		private initialized = false;

		connectedCallback() {
			if (this.initialized) return;
			const button = this.querySelector<HTMLButtonElement>('[data-flip-button]');
			const action = this.querySelector<HTMLElement>('[data-flip-action]');
			const hint = this.querySelector<HTMLElement>('[data-flip-hint]');
			const fallback = this.querySelector<HTMLElement>('[data-flip-fallback]');
			if (!button || !action || !hint || !fallback) return;

			// The native button supplies click, touch, Enter and Space activation.
			// The player's Space shortcut already excludes native button targets.
			button.addEventListener('click', () => this.showSide(this.dataset.side !== 'back'));
			this.addEventListener('cosmic-label-reset', () => this.reset());
			action.textContent = 'Flip label';
			hint.hidden = false;
			fallback.hidden = true;
			button.disabled = false;
			this.initialized = true;
		}

		/** Allows the enclosing release card to return to its information side. */
		reset() {
			if (this.dataset.side !== 'back') return;
			this.setAttribute('data-resetting', '');
			this.showSide(false);
			// Commit the front face without animating when a release is reopened.
			this.querySelector('[data-flip-button]')?.getBoundingClientRect();
			this.removeAttribute('data-resetting');
		}

		private showSide(backIsVisible: boolean) {
			const front = this.querySelector<HTMLImageElement>('[data-flip-front]');
			const back = this.querySelector<HTMLImageElement>('[data-flip-back]');
			const button = this.querySelector<HTMLButtonElement>('[data-flip-button]');
			const hint = this.querySelector<HTMLElement>('[data-flip-hint]');
			const status = this.querySelector<HTMLElement>('[data-flip-status]');
			if (!front || !back || !button || !hint || !status) return;

			this.dataset.side = backIsVisible ? 'back' : 'front';
			front.setAttribute('aria-hidden', String(backIsVisible));
			back.setAttribute('aria-hidden', String(!backIsVisible));
			const nextSide = backIsVisible ? 'information side' : 'other side';
			button.setAttribute('aria-label', `Flip label for ${this.dataset.title}. Show ${nextSide}.`);
			hint.textContent = `Show ${nextSide} ↻`;
			status.textContent = `${backIsVisible ? 'Other side' : 'Information side'} shown: ${backIsVisible ? back.alt : front.alt}`;
		}
	}

	if (!customElements.get('cosmic-label-flip')) {
		customElements.define('cosmic-label-flip', CosmicLabelFlip);
	}
</script>

<style>
	.cosmic-label-flip {
		display: grid;
		grid-template-rows: minmax(0, 1fr) auto;
		width: 100%;
		height: 100%;
		min-height: inherit;
		min-width: 0;
		background: transparent;
	}

	/* Specificity keeps the dossier's generic button chrome off the artwork. */
	cosmic-label-flip.cosmic-label-flip .cosmic-label-flip__button,
	cosmic-label-flip.cosmic-label-flip .cosmic-label-flip__button:hover,
	cosmic-label-flip.cosmic-label-flip .cosmic-label-flip__button:disabled {
		appearance: none;
		display: grid;
		grid-template-rows: minmax(0, 1fr) auto;
		gap: .5rem;
		width: 100%;
		height: 100%;
		min-height: 0;
		min-width: 0;
		margin: 0;
		padding: 0;
		border: 0;
		border-radius: 0;
		background: transparent;
		box-shadow: none;
		color: var(--dossier-ivory, #eee0c5);
		font: inherit;
		letter-spacing: normal;
		text-transform: none;
		cursor: pointer;
		touch-action: manipulation;
		-webkit-tap-highlight-color: transparent;
	}

	cosmic-label-flip.cosmic-label-flip .cosmic-label-flip__button:disabled { cursor: default; }
	cosmic-label-flip.cosmic-label-flip .cosmic-label-flip__button:focus-visible {
		outline: 2px solid var(--dossier-brass, #dfbb82);
		outline-offset: -2px;
		background: transparent;
	}

	.cosmic-label-flip__viewport {
		display: block;
		position: relative;
		min-height: 0;
		perspective: 1000px;
	}

	.cosmic-label-flip__rotor {
		display: block;
		position: absolute;
		inset: 0;
		transform-style: preserve-3d;
		transition: transform 480ms cubic-bezier(.2, .65, .25, 1);
	}

	.cosmic-label-flip[data-side="back"] .cosmic-label-flip__rotor { transform: rotateY(180deg); }
	.cosmic-label-flip[data-resetting] .cosmic-label-flip__rotor { transition: none; }
	.cosmic-label-flip .cosmic-label-flip__face {
		position: absolute;
		inset: 0;
		display: block;
		width: 100%;
		height: 100%;
		object-fit: contain;
		border: 0;
		border-radius: 0;
		background: transparent;
		backface-visibility: hidden;
		-webkit-backface-visibility: hidden;
		pointer-events: none;
	}
	.cosmic-label-flip__face--back { transform: rotateY(180deg); }
	.cosmic-label-flip__hint { display: flex; flex-wrap: wrap; justify-content: center; gap: .25rem .6rem; font-size: .75rem; line-height: 1.4; }
	.cosmic-label-flip__hint span { color: var(--dossier-muted, #c8bda9); }
	.cosmic-label-flip__fallback { margin: .4rem 0 0; text-align: center; font-size: .75rem; }
	.cosmic-label-flip__fallback[hidden], .cosmic-label-flip__hint [hidden] { display: none; }
	.cosmic-label-flip__status { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }

	@media (prefers-reduced-motion: reduce) {
		.cosmic-label-flip__rotor { transition: none; }
	}
</style>
