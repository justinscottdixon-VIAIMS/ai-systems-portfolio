---
import portfolioRecordsSource from '../data/portfolio-records.json';
import { toPortfolioRecords } from '../lib/portfolio-records.mjs';

const records = toPortfolioRecords(portfolioRecordsSource);
const eraGroups = [...new Set(records.map((record) => record.era))].map((era) => ({
	era,
	records: records.filter((record) => record.era === era),
}));

const evidenceLabels = {
	'primary-public': 'PRIMARY SOURCE',
	'corroborated-public': 'CORROBORATED',
	'attributed-public': 'ATTRIBUTED',
	'owner-approved-archive': 'ARCHIVE APPROVED',
};
---

<section class="publications-module" aria-labelledby="publications-heading" data-career-release-index>
	<header class="publications-module__header">
		<div>
			<p class="publications-module__index">04 / EXTERNAL NODES</p>
			<h2 id="publications-heading">CAREER & RELEASE INDEX</h2>
			<p class="publications-module__intro">Select a record to present its role, chronology, and public references in the theater.</p>
			<p><a href="/archive/">Explore the detailed release archive →</a></p>
		</div>
		<span class="publications-module__status">{records.length} TOP-LEVEL DOSSIERS</span>
	</header>

	<div class="publications-module__filters" aria-label="Archive scope">
		<span>VINYL: JANUARY 1996 ONWARD</span>
		<span>MUSIC</span>
		<span>FILM</span>
		<span>DSP / PRODUCT</span>
	</div>

	<div class="publications-module__grid">
		{eraGroups.map((group) => (
			<article class="publications-module__group">
				<header class="publications-module__group-header">
					<h3>{group.era}</h3>
					<span>{group.records.length.toString().padStart(2, '0')} RECORDS</span>
				</header>

				<div class="publications-module__entries">
					{group.records.map((record) => (
						<button
							type="button"
							class="publications-module__entry"
							data-open-reference={record.id}
							aria-label={`Present ${record.title} in the theater`}
						>
							<div class="publications-module__entry-heading">
								<strong>{record.title}</strong>
								<span class="publications-module__badge">{record.category}</span>
							</div>
							<p class="publications-module__role">{record.roles.join(' · ')}</p>
							<div class="publications-module__meta">
								<span>{evidenceLabels[record.evidenceLevel]}</span>
								<time datetime={record.sortDate}>{record.dateDisplay}</time>
							</div>
						</button>
					))}
				</div>

				<footer class="publications-module__footer">
					<span>THEATER REFERENCE DECK</span>
					<span>CHRONOLOGICAL INDEX</span>
				</footer>
			</article>
		))}
	</div>
</section>
