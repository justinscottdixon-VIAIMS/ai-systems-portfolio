---
import portfolioRecordsSource from '../data/portfolio-records.json';
import { toPortfolioRecords } from '../lib/portfolio-records.mjs';

const records = toPortfolioRecords(portfolioRecordsSource);
---

<div class="credentials-playlist">
  <header class="credentials-playlist__header">
    <strong>CREDENTIALS PLAYLIST</strong>
    <span>{records.length} DOSSIERS</span>
  </header>
  <div class="media-library__scroll-shell">
    <ol id="playlist-credentials" class="media-library__items credentials-playlist__items" aria-label="Credentials dossiers">
      {records.map((record, index) => (
        <li>
          <button type="button" class="credentials-cue" data-open-reference={record.id} aria-current="false" aria-label={`Present ${record.title} in the theater`} title={record.title}>
            <span class="credentials-cue__number">{String(index + 1).padStart(2, '0')}</span>
            <span class="credentials-cue__title">{record.title}</span>
            <span class="credentials-cue__category">{record.category}</span>
          </button>
        </li>
      ))}
    </ol>
    <div class="playlist-scroll-rail" data-playlist-scroll-rail role="scrollbar" aria-label="Scroll Credentials playlist" aria-controls="playlist-credentials" aria-orientation="vertical" aria-valuemin="0" aria-valuenow="0" aria-valuemax="0" aria-disabled="true" tabindex="-1"><span data-playlist-scroll-thumb></span></div>
  </div>
  <a class="credentials-playlist__archive" href="/archive/">DETAILED RELEASE ARCHIVE ↗</a>
</div>
