---
import '../styles/global.css';
import { publicProfile, siteUrl, structuredIdentity } from '../lib/public-site.mjs';

const { compactMain = false } = Astro.props;
---
<!doctype html>
<html lang="en" class="bg-black text-zinc-200 antialiased">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{publicProfile.title}</title>
		<meta name="description" content={publicProfile.description} />
		<link rel="canonical" href={siteUrl} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="VIAIMS" />
		<meta property="og:title" content={publicProfile.title} />
		<meta property="og:description" content={publicProfile.description} />
		<meta property="og:url" content={siteUrl} />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={publicProfile.title} />
		<meta name="twitter:description" content={publicProfile.description} />
		<script type="application/ld+json" set:html={JSON.stringify(structuredIdentity()).replaceAll('<', '\u003c')} />
		<slot name="head" />
	</head>
	<body class="min-h-screen selection:bg-zinc-100 selection:text-black">
		<main class:list={['relative z-10 w-full max-w-7xl mx-auto px-6', compactMain ? 'main--compact' : 'py-12 md:py-16']}>
			<slot />
		</main>
		<canvas id="webgl-canvas" class="fixed inset-0 z-0 pointer-events-none opacity-40"></canvas>
	</body>
</html>
