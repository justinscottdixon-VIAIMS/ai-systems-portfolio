---
import '../styles/global.css';
---
<!doctype html>
<html lang="en" class="bg-black text-zinc-200 antialiased">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>Justin Scott Dixon | AI Systems & Spatial Audio Architect</title>
		<slot name="head" />
	</head>
	<body class="min-h-screen selection:bg-zinc-100 selection:text-black">
		<main class="relative z-10 w-full max-w-7xl mx-auto px-6 py-12 md:py-24">
			<slot />
		</main>
		<canvas id="webgl-canvas" class="fixed inset-0 z-0 pointer-events-none opacity-40"></canvas>
	</body>
</html>
